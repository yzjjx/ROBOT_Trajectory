% 三条轨迹均为 N x 3 矩阵：每行是一个同步时刻的 [X, Y, Z]。
% Ideal_traj：理想轨迹；Pos_traj：位置模式实际轨迹；PD_traj：PD 控制实际轨迹。
% 三个 MAT 文件中的变量名必须分别为 Ideal_traj、Pos_traj、PD_traj。

clear; clc; close all;

% 1. 导入三条轨迹。
load('Ideal_traj.mat', 'Ideal_traj');
load('Pos_traj.mat', 'Pos_traj');
load('PD_traj.mat', 'PD_traj');

% 2. 检查数据。误差计算要求三个轨迹已经按时间戳一一对应。
if size(Ideal_traj, 2) ~= 3 || size(Pos_traj, 2) ~= 3 || size(PD_traj, 2) ~= 3
    error('三条轨迹都必须是 N x 3 矩阵，每行格式为 [X, Y, Z]。');
end

if size(Ideal_traj, 1) ~= size(Pos_traj, 1) || ...
   size(Ideal_traj, 1) ~= size(PD_traj, 1)
    error('三条轨迹的点数不同。请先按时间戳同步后再计算误差。');
end

% 3. 计算两种控制方式相对理想轨迹的点位误差。
pos_error_xyz = Pos_traj - Ideal_traj;
pd_error_xyz = PD_traj - Ideal_traj;
pos_error = sqrt(sum(pos_error_xyz.^2, 2));
pd_error = sqrt(sum(pd_error_xyz.^2, 2));

fprintf('位置模式：RMS 误差 = %.4f，最大误差 = %.4f\n', ...
        sqrt(mean(pos_error.^2)), max(pos_error));
fprintf('PD 控制：RMS 误差 = %.4f，最大误差 = %.4f\n', ...
        sqrt(mean(pd_error.^2)), max(pd_error));

% 4. 用所有轨迹共同的中心和共同的显示范围。
% 这样两张三维图中的轨迹都会显示在坐标系中央，且比例完全一致。
all_traj = [Ideal_traj; Pos_traj; PD_traj];
center = (max(all_traj, [], 1) + min(all_traj, [], 1)) / 2;
half_range = max(max(all_traj, [], 1) - min(all_traj, [], 1)) / 2;
half_range = max(half_range * 1.1, eps);     % 留出 10% 的显示边距

x_range = center(1) + [-half_range, half_range];
y_range = center(2) + [-half_range, half_range];
z_range = center(3) + [-half_range, half_range];

% 5. 图一：理想轨迹 VS 位置模式轨迹。
figure('Color', 'w', 'Name', 'Ideal trajectory VS Position mode');
plot3(Ideal_traj(:,1), Ideal_traj(:,2), Ideal_traj(:,3), ...
      'b-', 'LineWidth', 2); hold on;
plot3(Pos_traj(:,1), Pos_traj(:,2), Pos_traj(:,3), ...
      'r-', 'LineWidth', 1.5);
grid on; axis equal; view(3);
xlim(x_range); ylim(y_range); zlim(z_range);
xlabel('X'); ylabel('Y'); zlabel('Z');
title('Ideal Trajectory VS Position Mode');
legend('Ideal trajectory', 'Position mode trajectory', 'Location', 'best');

% 6. 图二：理想轨迹 VS PD 控制轨迹。
figure('Color', 'w', 'Name', 'Ideal trajectory VS PD control');
plot3(Ideal_traj(:,1), Ideal_traj(:,2), Ideal_traj(:,3), ...
      'b-', 'LineWidth', 2); hold on;
plot3(PD_traj(:,1), PD_traj(:,2), PD_traj(:,3), ...
      'g-', 'LineWidth', 1.5);
grid on; axis equal; view(3);
xlim(x_range); ylim(y_range); zlim(z_range);
xlabel('X'); ylabel('Y'); zlabel('Z');
title('Ideal Trajectory VS PD Control');
legend('Ideal trajectory', 'PD control trajectory', 'Location', 'best');

% 6. 图三：pos轨迹 VS PD 控制轨迹。
figure('Color', 'w', 'Name', 'Pos trajectory VS PD control');
plot3(Pos_traj(:,1), Pos_traj(:,2), Pos_traj(:,3), ...
      'b-', 'LineWidth', 2); hold on;
plot3(PD_traj(:,1), PD_traj(:,2), PD_traj(:,3), ...
      'g-', 'LineWidth', 1.5);
grid on; axis equal; view(3);
xlim(x_range); ylim(y_range); zlim(z_range);
xlabel('X'); ylabel('Y'); zlabel('Z');
title('Pos Trajectory VS PD Control');
legend('Ideal trajectory', 'PD control trajectory', 'Location', 'best');

% 7. 图三：每一个同步点的三维位置误差。
figure('Color', 'w', 'Name', 'Point-wise trajectory error');
sample_index = 1:size(Ideal_traj, 1);
plot(sample_index, pos_error, 'r-', 'LineWidth', 1.2); hold on;
plot(sample_index, pd_error, 'g-', 'LineWidth', 1.2);
grid on;
xlabel('Synchronized point index');
ylabel('Position error');
title('Point-wise Position Error');
legend('Position mode error', 'PD control error', 'Location', 'best');
